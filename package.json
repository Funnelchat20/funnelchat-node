{
  "name": "@funnelchat/sdk",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript SDK for the Funnelchat public API: WhatsApp, contacts, messages, templates, forms, groups and webhooks",
  "license": "MIT",
  "author": {
    "name": "Funnelchat",
    "email": "soporte@funnelchat.com"
  },
  "homepage": "https://developers-portal.funnelchat.app/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funnelchat20/funnelchat-node.git"
  },
  "bugs": {
    "url": "https://github.com/Funnelchat20/funnelchat-node/issues",
    "email": "soporte@funnelchat.com"
  },
  "keywords": [
    "funnelchat",
    "whatsapp",
    "whatsapp-api",
    "api",
    "sdk",
    "webhooks",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "format:pending": "node scripts/format-pending.mjs",
    "generate:check": "node scripts/format-pending.mjs --check && node scripts/generate.mjs --check",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run generate:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
